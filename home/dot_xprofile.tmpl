{{- if .is_desktop_env -}}

# Map Caps Lock to Ctrl.
setxkbmap -option 'caps:ctrl_modifier'

# Generate Escpe key when Caps is pressed and released on its own.
xcape -e 'Caps_Lock=Escape'

{{-     if eq .chezmoi.hostname "2700x-linux" }}

# Setup my 2k 144hz monitor.
xrandr --output DP-0 --mode 2560x1440 --rate 120.00

# Setup mouse speed
xinput set-prop 'pointer:Logitech MX Master 3' 'libinput Accel Speed' -0.4

{{-     else if eq .chezmoi.hostname "11301-DT-021" }}

# Setup mouse speed
xinput set-prop "Logitech USB Receiver Mouse" "libinput Accel Speed" -0.4
xset s off dpms 1200 1200 1200

{{-     end }}

###############################################################
# workaround to use fcitx in kitty
###############################################################
export GTK_IM_MODULE=fcitx
export QT_IM_MODULE=fcitx
export GLFW_IM_MODULE=ibus
export XMODIFIERS=@im=fcitx

# i3 does not run XDG autostart, so fcitx5 runs as a systemd user service
# (~/.config/systemd/user/fcitx5.service). The user manager starts before X,
# so an enabled unit comes up without DISPLAY and cannot reach the X server.
# Hand it the X session's display and (re)start it here; restart also starts
# the unit on a machine where it was never enabled.
systemctl --user import-environment DISPLAY XAUTHORITY
systemctl --user restart fcitx5.service

{{- end }}
