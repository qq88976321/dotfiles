# herdr configuration, mirroring the tmux habits in dot_tmux.conf.tmpl.
# Reload a running server with: herdr server reload-config

# First-run onboarding already done; do not show it again.
onboarding = false

###############################################################
# Theme (tmux: wfxr/tmux-power, gold on the office desktop, sky elsewhere)
###############################################################
[theme]
{{- if eq .chezmoi.hostname "11301-DT-021" }}
# Closest built-in to tmux-power "gold": warm yellow/brown palette.
name = "gruvbox"
{{- else }}
# Picked via the settings UI (was tokyo-night at first).
name = "catppuccin"
{{- end }}
auto_switch = false

# Red-green colorblind-safe remap (Okabe-Ito palette) on top of the base
# theme: red becomes vermillion (clearly warm/orange), green becomes a
# bluish green, so agent blocked vs idle states stay distinguishable.
[theme.custom]
red = "#d55e00"
green = "#009e73"

###############################################################
# Keys
###############################################################
[keys]
# tmux: set -g prefix C-Space
prefix = "ctrl+space"

# tmux: bind | split-window -h  (panes side by side); prefix+v is the
# herdr default, kept as a secondary alias.
split_vertical = ["prefix+v", "prefix+|"]
# tmux: bind - split-window -v  (panes stacked); same as the herdr default,
# kept explicit to document the tmux parity.
split_horizontal = "prefix+minus"

# tmux: bind w ... tmux-window-jump (unified session+window picker).
# herdr's workspace picker is the same idea and already lives on prefix+w.
workspace_picker = "prefix+w"

# Indexed jump to the first nine agent rows (herdr has no agent picker
# popup; this is the direct-select equivalent). Raw ctrl+1..9, no prefix.
focus_agent = "ctrl+1..9"

# prefix+[ is the stock tmux copy-mode entry: native copy mode, full
# scrollback, no search. prefix+/ (tmux: copy-mode + search) opens the
# copy-search plugin below, which has in-mode search but only sees the
# most recent ~1000 lines (herdr pane read server cap).
copy_mode = "prefix+["
edit_scrollback = "prefix+e"

focus_pane_up = ["prefix+k", "prefix+up"]
focus_pane_down = ["prefix+j", "prefix+down"]
focus_pane_left = ["prefix+h", "prefix+left"]
focus_pane_right = ["prefix+l", "prefix+right"]

# tmux-sensible habit: keep ctrl held after the prefix, so both
# prefix n and prefix ctrl+n switch tabs (tmux C-n/C-p).
next_tab = ["prefix+n", "prefix+ctrl+n"]
previous_tab = ["prefix+p", "prefix+ctrl+p"]

# tmux default-key parity; herdr defaults are kept as secondary
# bindings where they do not collide.
detach = "prefix+d"                                  # tmux: d, herdr: q
rename_tab = ["prefix+comma", "prefix+shift+t"]      # tmux: , renames window
rename_workspace = ["prefix+$", "prefix+shift+w"]    # tmux: $ renames session
close_tab = ["prefix+ampersand", "prefix+shift+x"]   # tmux: & kills window
last_pane = "prefix+;"                               # tmux: ; last active pane
cycle_pane_next = "prefix+o"                         # tmux: o next pane; frees
                                                     # prefix+tab for the
                                                     # scrollback search below
open_notification_target = "prefix+shift+o"          # moved off prefix+o

# Defaults that already match the tmux muscle memory (listed for reference,
# no need to override): new_tab prefix+c, switch_tab prefix+1..9,
# zoom prefix+z, close_pane prefix+x, help prefix+?.

# copy-search plugin (~/projects/herdr-copy-search): tmux-style copy
# mode with incremental search, copycat patterns (p menu / alt+key),
# and extrakto-style extraction; copies via OSC 52.

# tmux: bind / copy-mode + search; Esc from the prompt drops into the
# plugin's copy mode.
[[keys.command]]
key = "prefix+/"
type = "shell"
command = "herdr plugin pane open --plugin copy-search --entrypoint search"
description = "scrollback search (copy-search)"

# extrakto (tmux: prefix+tab popup): enter inserts, tab copies,
# ctrl+t toggles word/line.
[[keys.command]]
key = "prefix+tab"
type = "shell"
command = "herdr plugin pane open --plugin copy-search --entrypoint extract"
description = "extract tokens (copy-search)"

###############################################################
# UI
###############################################################
[ui]
# tmux: set -g mouse on. herdr default is already true; kept explicit.
# Pane apps that request mouse (Claude Code, vim, htop) still receive it,
# which covers the mouse_any_flag forwarding hacks from tmux.conf.
mouse_capture = true

# Replaces the cc-window-name automatic-rename habit: show the detected
# agent (claude, codex, ...) on split pane borders when no manual name is set.
show_agent_labels_on_pane_borders = true

# tmux: allow-passthrough for Claude Code notifications. herdr forwards
# agent notifications to the outer terminal as desktop notifications.
[ui.toast]
delivery = "terminal"

###############################################################
# Session persistence (tmux: resurrect + continuum)
###############################################################
[session]
# Resume AI-agent panes into their native conversation sessions after a
# server restart; herdr default, kept explicit as the resurrect stand-in.
resume_agents_on_restore = true

[experimental]
# Save recent pane screen history across full server restarts.
# Off for now; flip to true for behavior closer to tmux-resurrect.
pane_history = false

###############################################################
# Scrollback (tmux: history-limit 30000 lines)
###############################################################
[advanced]
# herdr counts bytes, not lines. The 10 MB default already exceeds
# 30000 lines of typical output; kept explicit to record the intent.
scrollback_limit_bytes = 10000000
